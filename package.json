{
  "name": "wasel-lan",
  "version": "0.1.0",
  "description": "تطبيق تواصل محلي للمنشآت دون إنترنت",
  "main": "src/main.js",
  "author": "Wasel LAN",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.wasel.lan",
    "productName": "واصل - تواصل المنشأة",
    "directories": { "output": "release" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"], "artifactName": "Wasel-LAN-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}

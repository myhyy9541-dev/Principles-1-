{
  "name": "fursan-lan",
  "version": "0.4.0",
  "description": "فرسان LAN — تواصل عربي عبر الشبكة المحلية",
  "main": "src/main.js",
  "author": "Fursan LAN",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.fursan.lan",
    "productName": "فرسان LAN",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Fursan-LAN-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

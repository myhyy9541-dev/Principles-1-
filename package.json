{
  "name": "fursan-lan",
  "version": "0.5.0",
  "description": "فرسان لان — مراسلة P2P عربية عبر Wi-Fi وBluetooth Classic",
  "main": "src/main.js",
  "author": "فريق فرسان لان",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.6"
  },
  "build": {
    "appId": "com.fursan.lan",
    "productName": "فرسان لان",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Fursan-Lan-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Fursan-Lan-Portable-${version}-${arch}.${ext}"
    }
  }
}
